{
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "**/.git/**",
    "**/.DS_Store",
    "**/node_modules/**",
    "**/*.log",
    "**/*.xlsx"
  ],
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "markdown": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.eagerness": "auto"
}
